# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="DOTS Survivors Support"
SUPPORT_ADMIN_USER_IDS="" # comma-separated registered user IDs allowed to use /support/admin
SUPPORT_LLM_TIMEOUT_SECONDS=20
SUPPORT_OCR_COMMAND=tesseract
SUPPORT_OCR_LANGUAGES=chi_sim+eng+spa
SUPPORT_MINIO_ENDPOINT=localhost:19000
SUPPORT_MINIO_BUCKET=support-images
SUPPORT_MINIO_ACCESS_KEY=replace-with-unique-storage-user
SUPPORT_MINIO_SECRET_KEY=replace-with-a-long-random-secret
SUPPORT_MINIO_SECURE=false
# Optional OpenAI-compatible vision model for staff caption suggestions.
# Staff must review and save the suggestion before publishing the document.
# SUPPORT_VISION_MODEL=qwen3-vl-plus
# SUPPORT_VISION_API_KEY=your-vision-api-key
# SUPPORT_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Optional 1024-dimension embedding endpoint. DashScope text-embedding-v3 is used
# when DASHSCOPE_API_KEY is set; otherwise OpenAI text-embedding-3-small.
# An OpenAI-compatible BGE endpoint can be configured here instead.
# SUPPORT_EMBEDDING_MODEL=text-embedding-v3
# SUPPORT_EMBEDDING_API_KEY=your-embedding-key
# SUPPORT_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SUPPORT_EMBEDDING_DIMENSIONS=1024
SUPPORT_MILVUS_URI=http://localhost:19530
# Set this when Milvus authentication is enabled (user:password).
SUPPORT_MILVUS_TOKEN=
SUPPORT_MILVUS_COLLECTION=support_knowledge_v1
SUPPORT_CATALOG_COLLECTION=support_catalog_v1
SUPPORT_CELERY_BROKER_URL=redis://localhost:6379/1
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Settings
OPENAI_API_KEY="your-llm-api-key" # e.g. OpenAI API key
DEFAULT_LLM_MODEL=gpt-5.6-luna

# Optional Qwen via Alibaba Cloud Model Studio (DashScope OpenAI-compatible API)
# Set a DashScope API key and choose qwen-plus or qwen-max as DEFAULT_LLM_MODEL.
# DASHSCOPE_API_KEY="your-dashscope-api-key"
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEFAULT_LLM_MODEL=qwen-plus

# Atlas Cloud (OpenAI-compatible) — alternative to OpenAI, access 59+ LLMs with one key
# Get your free key at: https://www.atlascloud.ai/console/coding-plan
# OPENAI_BASE_URL=https://api.atlascloud.ai/v1
# OPENAI_API_KEY=<your-atlascloud-key>
# DEFAULT_LLM_MODEL=deepseek-ai/deepseek-v4-pro
DEFAULT_LLM_TEMPERATURE=0.2
SESSION_NAMING_ENABLED=true

# JWT Settings
JWT_SECRET_KEY="CHANGE_ME_TO_A_RANDOM_32_PLUS_CHAR_STRING"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Profiling Settings
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console
